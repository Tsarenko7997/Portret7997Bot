TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE

# Integers in Telegram Stars. Leave empty until prices are agreed.
POSITION_PRICE_XTR=
BUNDLE_PRICE_XTR=

# On Railway mount a persistent Volume at /data before enabling prices.
DATA_DIR=./data

# Numeric Telegram ID of the owner. Get it by sending /myid to this bot.
# Without this value nobody can create or revoke invitations.
BOT_OWNER_ID=
